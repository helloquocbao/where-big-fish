# Copy to .env for local overrides (không commit .env thật - đã có trong .gitignore).
# Đọc bởi Vite lúc build (import.meta.env) - phải set TRƯỚC khi chạy `npm run build`, không đổi
# được sau khi đã build tĩnh. Xem chi tiết ở docs/deployment_guide.md.

# WebSocket URL của backend. Bắt buộc "wss://" nếu frontend chạy qua HTTPS.
# Nếu không set, mặc định rơi về ws://localhost:2567 (chỉ dùng được lúc dev local) - PHẢI set biến
# này khi build cho production, nếu không server sẽ cố kết nối tới localhost và luôn thất bại.
VITE_SERVER_URL=wss://your-backend.example

# Google AdSense integration
# Leave CONTENT blank to disable production banners. Dev only shows a preview.
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_CONNECT=
VITE_ADSENSE_SLOT_HUD=
VITE_ADSENSE_SLOT_COLLECTION=

# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=


# Responsive Display ad unit ID from AdSense (data-ad-slot).
VITE_ADSENSE_SLOT_CONTENT=
